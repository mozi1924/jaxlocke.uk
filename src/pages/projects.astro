---
import Layout from "../layouts/Layout.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import { Gallery } from "../components/Gallery";
import { Navigation } from "../components/Navigation";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const items = projects.map((item) => ({ id: item.id, ...item.data }));
---

<Layout title="WIP Projects | Jax Locke">
    <Navigation
        activeSection="projects"
        pathname={Astro.url.pathname}
        scrollToSection={() => {}}
        client:load
    />

    <main class="pt-32 pb-20 min-h-screen">
        <Container>
            <SectionHeading
                title="IN PROGRESS"
                subtitle="Current explorations and unfinished business."
            />
            <Gallery items={items} gridCols={2} client:load />
        </Container>
    </main>
</Layout>
