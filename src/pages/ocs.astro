---
import Layout from "../layouts/Layout.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import { Gallery } from "../components/Gallery";
import { Navigation } from "../components/Navigation";
import { getCollection } from "astro:content";

const ocs = await getCollection("ocs");
const items = ocs.map((item) => ({ id: item.id, ...item.data }));
---

<Layout title="Original Characters | Jax Locke">
    <Navigation
        activeSection="oc"
        pathname={Astro.url.pathname}
        scrollToSection={() => {}}
        client:load
    />

    <main class="pt-32 pb-20 min-h-screen">
        <Container>
            <SectionHeading
                title="ORIGINALS"
                subtitle="Original Characters & World building."
            />
            <Gallery items={items} gridCols={3} client:load />
        </Container>
    </main>
</Layout>
