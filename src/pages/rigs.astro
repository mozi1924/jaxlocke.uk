---
import Layout from "../layouts/Layout.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import { RigList } from "../components/RigList";
import { Navigation } from "../components/Navigation";
import { getCollection } from "astro:content";

const rigs = await getCollection("rigs");
const items = rigs.map((item) => ({ id: item.id, ...item.data }));
---

<Layout title="Rigs | Jax Locke">
    <Navigation
        activeSection="rigs"
        pathname={Astro.url.pathname}
        scrollToSection={() => {}}
        client:load
    />

    <main class="pt-32 pb-20 min-h-screen">
        <Container>
            <SectionHeading
                title="RIGS"
                subtitle="Production ready rigs for Maya & Blender."
            />
            <RigList rigs={items} client:load />
        </Container>
    </main>
</Layout>
