---
import Layout from "../layouts/Layout.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import { Home } from "lucide-react";
---

<Layout title="404 - Page Not Found">
    <main class="min-h-screen flex items-center justify-center text-center">
        <Container>
            <div class="relative inline-block mb-8">
                <h1
                    class="text-9xl font-display font-bold text-[#38303f]/50 select-none"
                >
                    404
                </h1>
                <div class="absolute inset-0 flex items-center justify-center">
                    <h2
                        class="text-4xl md:text-6xl font-display font-bold text-white tracking-widest"
                    >
                        LOST?
                    </h2>
                </div>
            </div>

            <p class="text-zinc-400 text-xl max-w-md mx-auto mb-12">
                The page you are looking for has been moved, deleted, or
                possibly never existed.
            </p>

            <Button href="/" variant="primary">
                <Home size={20} />
                Return Home
            </Button>
        </Container>

        {/* Background Deco */}
        <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#3f89fc]/5 blur-[100px] rounded-full -z-10 pointer-events-none"
        >
        </div>
    </main>
</Layout>
