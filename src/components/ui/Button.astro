---
interface Props {
    href?: string;
    type?: "button" | "submit" | "reset";
    variant?: "primary" | "secondary" | "outline" | "ghost";
    class?: string;
    [key: string]: any;
}

const {
    href,
    type = "button",
    variant = "primary",
    class: className,
    ...rest
} = Astro.props;

const baseStyles =
    "inline-flex items-center gap-2 font-mono uppercase tracking-widest transition-colors cursor-pointer";
const variants = {
    primary: "bg-[#3f89fc] text-white px-6 py-3 rounded hover:bg-[#3f89fc]/90",
    secondary:
        "bg-[#38303f] text-white px-6 py-3 rounded hover:bg-[#38303f]/90",
    outline:
        "border border-[#3f89fc] text-[#3f89fc] px-6 py-3 rounded hover:bg-[#3f89fc]/10",
    ghost: "text-zinc-400 hover:text-white",
};

const Tag = href ? "a" : "button";
---

<Tag
    href={href}
    type={!href ? type : undefined}
    class:list={[baseStyles, variants[variant], className]}
    {...rest}
>
    <slot />
</Tag>
